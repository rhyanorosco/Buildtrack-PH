{
  "expo": {
    "name": "BuildTrack PH",
    "slug": "buildtrack-ph",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "buildtrackph",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sharing"
    ],
    "icon": "./assets/icon.png",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
